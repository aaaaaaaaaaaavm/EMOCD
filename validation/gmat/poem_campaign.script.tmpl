%  VOLLEY analysis A15 - twelve-satellite deployment campaign from POEM
%  Generated by build_poem_campaign.py; DO NOT edit this file - edit the template.
%
%  Reference orbit: @@CASE_ID@@  alt @@ALT_KM@@ km, inc @@INC_DEG@@ deg  @@ORBIT_PROVENANCE@@
%  Cadence @@SPACING_S@@ s per ADR-020 (closes P31); @@N_SHOTS@@ shots; dv @@DV@@ m/s
%
%  Each satellite is placed on the orbit it has AFTER its own burn, with mean anomaly
%  rewound by n*t_k so that at t = t_k it sits at the burn point. This is the same
%  staggering emocd_fleet.script.tmpl uses, and it is what lets one Propagate
%  Synchronized carry objects that were physically released at different times.
%  It ignores J2 during the rewind, which is under a 4 hour campaign against a 90 day
%  propagation.

Create Spacecraft poem;
GMAT poem.DateFormat = UTCGregorian;
GMAT poem.Epoch = '@@EPOCH@@';
GMAT poem.CoordinateSystem = EarthMJ2000Eq;
GMAT poem.DisplayStateType = Keplerian;
GMAT poem.SMA = @@SMA_BASE_KM@@;
GMAT poem.ECC = @@ECC_BASE@@;
GMAT poem.INC = @@INC_DEG@@;
GMAT poem.RAAN = 0;
GMAT poem.AOP = 0;
GMAT poem.TA = 0;
GMAT poem.DryMass = @@STAGE_MASS_KG@@;
GMAT poem.Cd = @@CD@@;
GMAT poem.DragArea = @@STAGE_DRAG_AREA_M2@@;
GMAT poem.Cr = 1.8;
GMAT poem.SRPArea = @@STAGE_DRAG_AREA_M2@@;

@@SPACECRAFT_BLOCK@@

Create ForceModel LEOForces;
GMAT LEOForces.CentralBody = Earth;
GMAT LEOForces.PrimaryBodies = {Earth};
GMAT LEOForces.PointMasses = {Luna, Sun};
GMAT LEOForces.SRP = On;
GMAT LEOForces.GravityField.Earth.Degree = @@GRAV_DEGREE@@;
GMAT LEOForces.GravityField.Earth.Order = @@GRAV_ORDER@@;
GMAT LEOForces.Drag.AtmosphereModel = @@ATMOSPHERE@@;
GMAT LEOForces.Drag.F107 = @@F107@@;
GMAT LEOForces.Drag.F107A = @@F107A@@;
GMAT LEOForces.Drag.MagneticIndex = @@KP@@;

Create Propagator LEOProp;
GMAT LEOProp.FM = LEOForces;
GMAT LEOProp.Type = @@INTEGRATOR@@;
GMAT LEOProp.InitialStepSize = 60;
GMAT LEOProp.Accuracy = 1e-9;
GMAT LEOProp.MinStep = 30;
GMAT LEOProp.MaxStep = 2700;

@@REPORT_BLOCK@@

BeginMissionSequence;

Propagate Synchronized LEOProp(@@PROP_LIST@@) {poem.ElapsedDays = @@DAYS@@};

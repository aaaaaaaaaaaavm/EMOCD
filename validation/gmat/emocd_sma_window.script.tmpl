%  EMOCD analysis A5 (bounded leg) -- semi-major-axis decay over a fixed window
%  Generated by build_scripts.py; compares against analysis/astro.py cowell_sma_after().
%  Baseline = @@SMA_BASE_KM@@ km circular; boosted = the same orbit after a @@DV@@ m/s
%  prograde ejection at perigee (a, e from astro.boosted_elements -- not re-derived here).
%  DO NOT edit this file -- edit the template and re-run build_scripts.py

Create Spacecraft baseline;
GMAT baseline.DateFormat = UTCGregorian;
GMAT baseline.Epoch = '@@EPOCH@@';
GMAT baseline.CoordinateSystem = EarthMJ2000Eq;
GMAT baseline.DisplayStateType = Keplerian;
GMAT baseline.SMA = @@SMA_BASE_KM@@;
GMAT baseline.ECC = @@ECC_BASE@@;
GMAT baseline.INC = @@INC_DEG@@;
GMAT baseline.RAAN = 0;
GMAT baseline.AOP = 0;
GMAT baseline.TA = 0;
GMAT baseline.DryMass = @@MASS_KG@@;
GMAT baseline.Cd = @@CD@@;
GMAT baseline.DragArea = @@DRAG_AREA_M2@@;
GMAT baseline.Cr = 1.8;
GMAT baseline.SRPArea = @@DRAG_AREA_M2@@;

Create Spacecraft boosted;
GMAT boosted.DateFormat = UTCGregorian;
GMAT boosted.Epoch = '@@EPOCH@@';
GMAT boosted.CoordinateSystem = EarthMJ2000Eq;
GMAT boosted.DisplayStateType = Keplerian;
GMAT boosted.SMA = @@SMA_BOOST_KM@@;
GMAT boosted.ECC = @@ECC_BOOST@@;
GMAT boosted.INC = @@INC_DEG@@;
GMAT boosted.RAAN = 0;
GMAT boosted.AOP = 0;
GMAT boosted.TA = 0;
GMAT boosted.DryMass = @@MASS_KG@@;
GMAT boosted.Cd = @@CD@@;
GMAT boosted.DragArea = @@DRAG_AREA_M2@@;
GMAT boosted.Cr = 1.8;
GMAT boosted.SRPArea = @@DRAG_AREA_M2@@;

Create ForceModel LEOForces;
GMAT LEOForces.CentralBody = Earth;
GMAT LEOForces.PrimaryBodies = {Earth};
GMAT LEOForces.PointMasses = {Luna, Sun};
GMAT LEOForces.SRP = On;
GMAT LEOForces.GravityField.Earth.Degree = @@GRAV_DEGREE@@;
GMAT LEOForces.GravityField.Earth.Order = @@GRAV_ORDER@@;
GMAT LEOForces.Drag.AtmosphereModel = @@ATMOSPHERE@@;
GMAT LEOForces.Drag.F107 = @@F107@@;
GMAT LEOForces.Drag.F107A = @@F107A@@;
GMAT LEOForces.Drag.MagneticIndex = @@KP@@;

Create Propagator LEOProp;
GMAT LEOProp.FM = LEOForces;
GMAT LEOProp.Type = @@INTEGRATOR@@;
GMAT LEOProp.InitialStepSize = 60;
GMAT LEOProp.Accuracy = 1e-11;
GMAT LEOProp.MinStep = 0.001;
GMAT LEOProp.MaxStep = 2700;

Create ReportFile rptSMA;
GMAT rptSMA.Filename = '@@OUT_SMA@@';
GMAT rptSMA.WriteHeaders = true;
GMAT rptSMA.LeftJustify = On;
GMAT rptSMA.ColumnWidth = 20;

Create Variable day;

BeginMissionSequence;

Report rptSMA day baseline.Earth.SMA boosted.Earth.SMA baseline.Earth.Altitude boosted.Earth.Altitude;

For day = 1:@@DAYS@@;
   Propagate Synchronized LEOProp(baseline, boosted) {baseline.ElapsedSecs = 86400};
   Report rptSMA day baseline.Earth.SMA boosted.Earth.SMA baseline.Earth.Altitude boosted.Earth.Altitude;
EndFor;

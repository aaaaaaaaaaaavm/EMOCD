%  EMOCD analysis A6 input - fleet ephemerides for conjunction screening
%  Generated by build_scripts.py; mirrors astro.py conjunction() staggering:
%  shot k fires at t = k * @@SPACING_S@@ s, AOP = n0*tk, mean anomaly = -n1*tk.
%  Writes one CCSDS OEM per object over @@DAYS@@ days. These files are the input to
%  validation/A6_conjunction_cara.md - they replace astro.py's Kepler + secular-J2
%  propagate() with a real integrator for the conjunction geometry.
%  DO NOT edit this file - edit the template and re-run build_scripts.py

Create Spacecraft stage;
GMAT stage.DateFormat = UTCGregorian;
GMAT stage.Epoch = '@@EPOCH@@';
GMAT stage.CoordinateSystem = EarthMJ2000Eq;
GMAT stage.DisplayStateType = Keplerian;
GMAT stage.SMA = @@SMA_BASE_KM@@;
GMAT stage.ECC = @@ECC_BASE@@;
GMAT stage.INC = @@INC_DEG@@;
GMAT stage.RAAN = 0;
GMAT stage.AOP = 0;
GMAT stage.TA = 0;
GMAT stage.DryMass = @@STAGE_MASS_KG@@;
GMAT stage.Cd = @@CD@@;
GMAT stage.DragArea = @@STAGE_DRAG_AREA_M2@@;
GMAT stage.Cr = 1.8;
GMAT stage.SRPArea = @@STAGE_DRAG_AREA_M2@@;

@@SPACECRAFT_BLOCK@@

Create ForceModel LEOForces;
GMAT LEOForces.CentralBody = Earth;
GMAT LEOForces.PrimaryBodies = {Earth};
GMAT LEOForces.PointMasses = {Luna, Sun};
GMAT LEOForces.SRP = On;
GMAT LEOForces.GravityField.Earth.Degree = @@GRAV_DEGREE@@;
GMAT LEOForces.GravityField.Earth.Order = @@GRAV_ORDER@@;
GMAT LEOForces.Drag.AtmosphereModel = @@ATMOSPHERE@@;
GMAT LEOForces.Drag.F107 = @@F107@@;
GMAT LEOForces.Drag.F107A = @@F107A@@;
GMAT LEOForces.Drag.MagneticIndex = @@KP@@;

Create Propagator LEOProp;
GMAT LEOProp.FM = LEOForces;
GMAT LEOProp.Type = @@INTEGRATOR@@;
GMAT LEOProp.InitialStepSize = 60;
GMAT LEOProp.Accuracy = 1e-11;
GMAT LEOProp.MinStep = 0.001;
GMAT LEOProp.MaxStep = 2700;

Create EphemerisFile ephStage;
GMAT ephStage.Spacecraft = stage;
GMAT ephStage.Filename = '@@OUT_DIR@@/stage.oem';
GMAT ephStage.FileFormat = CCSDS-OEM;
GMAT ephStage.CoordinateSystem = EarthMJ2000Eq;
GMAT ephStage.StepSize = @@EPH_STEP_S@@;

@@EPHEMERIS_BLOCK@@

BeginMissionSequence;

Propagate Synchronized LEOProp(@@PROP_LIST@@) {stage.ElapsedDays = @@DAYS@@};
